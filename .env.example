# Local development: fill privately in .env; never commit credentials.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=furniture_db
PGUSER=furniture_app
PGPASSWORD=REPLACE_WITH_YOUR_PASSWORD
DATABASE_URL="postgresql://furniture_app:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/furniture_db?schema=public"
SHADOW_DATABASE_URL="postgresql://furniture_app:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/furniture_shadow?schema=public"
TEST_DATABASE_URL="postgresql://furniture_app:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/furniture_test_catalog?schema=public"
PORT=4000
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development
SHIPPING_FEE_VND=50000
# Leave all bank fields empty to disable bank-transfer checkout.
BANK_NAME=
BANK_ACCOUNT=
BANK_HOLDER=
# Docker only: same password in the two variables; URL-encode in the URL.
DOCKER_DB_PASSWORD=REPLACE_WITH_YOUR_PASSWORD
DOCKER_DATABASE_URL="postgresql://furniture_app:REPLACE_WITH_URL_ENCODED_PASSWORD@db:5432/furniture_db?schema=public"
